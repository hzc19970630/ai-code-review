APP_ENV=development
DATABASE_URL=postgresql+psycopg://mr_review:mr_review@postgres:5432/mr_review
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=mr-review
QUEUE_ENABLED=true
AUTO_CREATE_SCHEMA=false
API_BEARER_TOKEN_REF=env://API_BEARER_TOKEN

GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_CA_BUNDLE=
GITLAB_REQUEST_TIMEOUT_SECONDS=30
GITLAB_MAX_RETRIES=3

LLM_BASE_URL=http://llm-gateway.example.com/v1
LLM_API_KEY_REF=env://LLM_API_KEY
LLM_MODEL=qwen-coder
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

WEBHOOK_MAX_BODY_BYTES=2097152
REVIEW_JOB_TIMEOUT_SECONDS=300
REVIEW_MAX_ATTEMPTS=3
RECONCILE_INTERVAL_SECONDS=30
RECONCILE_GRACE_SECONDS=60
DISPATCH_INTERVAL_SECONDS=1
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
ENQUEUE_LOCK_SECONDS=60
LINEAGE_REPLACEMENT_WINDOW_SECONDS=604800
LOG_LEVEL=INFO

# Project Secret examples. Do not commit real values.
DEMO_WEBHOOK_SECRET=replace-me
DEMO_GITLAB_TOKEN=replace-me
LLM_API_KEY=replace-me
API_BEARER_TOKEN=replace-me
